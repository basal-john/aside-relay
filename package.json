{
  "name": "aside-remote",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:backend && npm run test:mutations && npm run build && npm run test:smoke && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:backend": "node tests/run-backend.mjs",
    "test:mutations": "node tests/verify-mutations.mjs",
    "test:smoke": "node tests/boot.test.mjs",
    "test:e2e": "tsc -p tsconfig.tests.json && playwright test",
    "test:repeat": "playwright test --repeat-each=3"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@stylexjs/stylex": "^0.19.1",
    "lucide-react": "^1.54.0",
    "mdast-util-from-markdown": "^2.1.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.16",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
